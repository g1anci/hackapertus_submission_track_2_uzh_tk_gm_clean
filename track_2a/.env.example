# Either `http://host.docker.internal:8080/v1` if you serve the model through
# CSCS Clariden with an ssh tunnel or the base url of your API provider
LLM_BASE_URL=http://host.docker.internal:8080/v1
# Either `<your-cscs-username>/swiss-ai/Apertus-v1.5-8B` for the base-line run
# or `swiss-ai/apertus1.5-8b-rsd-mixed-weighted` to use our qLoRA fine-tuned version
# or `<your-cscs-username>/swiss-ai/apertus1.5-8b-rsd-mixed-weighted-full-fine-tune` for our
# full LoRA fine-tuned version
LLM_NAME=swiss-ai/apertus1.5-8b-rsd-mixed-weighted
# Only needed if you use an API instead of serving the model through CSCS Clariden
LLM_API_KEY=NONE
# Only needed if you encounter a HF error
HF_TOKEN=
# `validation`, `test` or `full` (validation + test)
SPLIT=test
# `on` or `off` for the `train` pipeline
PILOT=on
